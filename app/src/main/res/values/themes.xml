<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.TapCardWebSDK" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/signal</item>
        <item name="colorPrimaryVariant">@color/signal</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/signal</item>
        <item name="colorSecondaryVariant">@color/signal</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Surfaces resolve per device theme via values / values-night. -->
        <item name="android:colorBackground">@color/bench</item>
        <item name="colorSurface">@color/stage</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_muted</item>
        <item name="android:statusBarColor">@color/bench</item>
        <item name="android:navigationBarColor">@color/bench</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.Medium</item>
    </style>

    <!-- MainActivity draws its own header, so it drops the system action bar. -->
    <style name="Theme.TapCardWebSDK.NoActionBar" parent="Theme.TapCardWebSDK">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="ShapeAppearance.App.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius_small</item>
    </style>

    <style name="ShapeAppearance.App.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius</item>
    </style>

</resources>
